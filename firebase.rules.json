{
  "rules": {
    ".read": false,
    ".write": false,

    "espaces": {
      "$espace": {
        ".read": "auth != null && auth.uid === $espace",
        ".write": "auth != null && auth.uid === $espace",

        "identite": {
          ".validate": "newData.hasChildren(['nom']) && newData.child('nom').isString() && newData.child('nom').val().length <= 120"
        },

        "exercices": {
          "$exercice": {
            ".validate": "newData.hasChildren(['id', 'rev', 'updatedBy']) && newData.child('id').val() === $exercice && ((!data.exists() || !data.hasChild('rev')) ? newData.child('rev').val() >= 1 : newData.child('rev').val() === data.child('rev').val() + 1)",
            "rev": { ".validate": "newData.isNumber()" },
            "updatedBy": { ".validate": "newData.isString() && newData.val() === auth.uid" }
          }
        },

        "groupes": {
          "$groupe": {
            ".read": "auth != null && root.child('espaces').child($espace).child('coachs').child($groupe).child(auth.uid).exists()",
            ".write": "auth != null && root.child('espaces').child($espace).child('coachs').child($groupe).child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['id', 'rev', 'updatedBy']) && newData.child('id').val() === $groupe && ((!data.exists() || !data.hasChild('rev')) ? newData.child('rev').val() >= 1 : newData.child('rev').val() === data.child('rev').val() + 1)",
            "rev": { ".validate": "newData.isNumber()" },
            "updatedBy": { ".validate": "newData.isString() && newData.val() === auth.uid" }
          }
        },

        "coachs": {
          "$groupe": {
            ".read": "auth != null && root.child('espaces').child($espace).child('coachs').child($groupe).child(auth.uid).exists()",

            "$coach": {
              ".write": "auth != null && ( ($coach === auth.uid && !data.exists() && auth.token.email != null && auth.token.email_verified === true && root.child('invitations').child(auth.token.email.replace('.', ',')).child($espace).child($groupe).exists()) || ($coach === auth.uid && !newData.exists()) )",
              ".validate": "newData.hasChildren(['nom', 'courriel', 'depuis']) && newData.child('courriel').val() === auth.token.email && newData.child('nom').isString() && newData.child('nom').val().length <= 80 && newData.child('depuis').val() <= now"
            }
          }
        },

        "bibliotheques": {
          "$groupe": {
            ".read": "auth != null && root.child('espaces').child($espace).child('coachs').child($groupe).child(auth.uid).exists()",
            ".write": "auth != null && root.child('espaces').child($espace).child('coachs').child($groupe).child(auth.uid).exists()",

            "$exercice": {
              ".validate": "newData.hasChildren(['id', 'rev', 'updatedBy']) && newData.child('id').val() === $exercice && ((!data.exists() || !data.hasChild('rev')) ? newData.child('rev').val() >= 1 : newData.child('rev').val() === data.child('rev').val() + 1)",
              "rev": { ".validate": "newData.isNumber()" },
              "updatedBy": { ".validate": "newData.isString() && newData.val() === auth.uid" }
            }
          }
        },

        "seances": {
          "$groupe": {
            ".read": "auth != null && root.child('espaces').child($espace).child('coachs').child($groupe).child(auth.uid).exists()",
            ".write": "auth != null && root.child('espaces').child($espace).child('coachs').child($groupe).child(auth.uid).exists()",

            "$seance": {
              ".validate": "newData.hasChildren(['id', 'rev', 'updatedBy']) && newData.child('id').val() === $seance && ((!data.exists() || !data.hasChild('rev')) ? newData.child('rev').val() >= 1 : newData.child('rev').val() === data.child('rev').val() + 1)",
              "rev": { ".validate": "newData.isNumber()" },
              "updatedBy": { ".validate": "newData.isString() && newData.val() === auth.uid" }
            }
          }
        },

        "corbeille": {
          "$type": {
            "$objet": {
              ".validate": "!newData.exists() || (newData.hasChildren(['id', 'supprimeLe']) && newData.child('supprimeLe').val() <= now)"
            }
          }
        }
      }
    },

    "invitations": {
      "$courriel": {
        ".read": "auth != null && auth.token.email != null && auth.token.email_verified === true && $courriel === auth.token.email.replace('.', ',')",

        "$espace": {
          ".read": "auth != null && auth.uid === $espace",
          ".write": "auth != null && auth.uid === $espace",

          "$groupe": {
            ".write": "auth != null && auth.token.email != null && auth.token.email_verified === true && $courriel === auth.token.email.replace('.', ',') && !newData.exists()",
            ".validate": "newData.hasChildren(['nomGroupe', 'par', 'le']) && newData.child('par').val() === $espace && newData.child('le').val() <= now && newData.child('nomGroupe').isString() && newData.child('nomGroupe').val().length <= 80"
          }
        }
      }
    },

    "confies": {
      "$coach": {
        ".read": "auth != null && auth.uid === $coach",

        "$espace": {
          "$groupe": {
            ".write": "auth != null && (auth.uid === $coach || auth.uid === $espace)",
            ".validate": "newData.hasChildren(['nom', 'par', 'le']) && newData.child('par').val() === $espace && newData.child('le').val() <= now"
          }
        }
      }
    }
  }
}
